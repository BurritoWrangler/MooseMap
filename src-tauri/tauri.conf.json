{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MooseMap",
  "version": "0.1.0",
  "identifier": "io.moosemap.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix ../frontend install && npm --prefix ../frontend run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm --prefix ../frontend install && npm --prefix ../frontend run build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "category": "Utility",
    "shortDescription": "Authorized external pentest orchestrator",
    "longDescription": "MooseMap drives recon and vulnerability scanning tools through a staged pipeline, tracks progress in real time, and prioritizes exploitable findings into a report. Authorized testing only."
  }
}
